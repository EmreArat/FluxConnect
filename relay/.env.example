# FluxConnect Relay Server — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Sunucu portu
PORT=8765

# TLS Sertifika yolları (production için zorunlu)
# TLS_CERT_PATH=./certs/cert.pem
# TLS_KEY_PATH=./certs/key.pem

# Geliştirme modunda TLS olmadan çalıştır (production'da false olmalı)
DEV_NO_TLS=true

# Rate limiting: IP başına saniyede max bağlantı isteği
RATE_LIMIT_PER_SECOND=10

# Bağlantı isteği zaman aşımı (ms) — kabul edilmezse otomatik iptal
SESSION_TIMEOUT_MS=30000

# Yanlış şifre sonrası kilit süresi (ms)
BRUTE_FORCE_LOCK_MS=30000

# Maksimum yanlış şifre denemesi
MAX_PASSWORD_ATTEMPTS=5

# ---- Kaynak koruma sınırları ----
# Relay paylaşımlı bir sunucuda çalışıyorsa bu sınırlar ŞART: sınırsız bırakılan
# her kaynak yanındaki uygulamaları (DB, web) aç bırakabilir.

# Tek mesajın azami boyutu (bayt). ws varsayılanı 100 MB — çok yüksek.
MAX_PAYLOAD_BYTES=1048576

# Eşzamanlı azami bağlantı (toplam / IP başına)
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_IP=10

# Medya akışı için BAĞLANTI BAŞINA saniyede bayt (3 MB/s = ~24 Mbit/s).
# Aşılırsa veri düşürülür, bağlantı kapatılmaz. 0 = sınırsız (ÖNERİLMEZ).
RELAY_BYTES_PER_SECOND=3145728

# TÜM relay trafiği için GLOBAL tavan (bayt/sn). Bağlantı başına limit tek başına
# yetmez: 200 bağlantı x 3 MB/s = 600 MB/s olurdu.
# 36 MB/s (~294 Mbit/s) = sunucunun ölçülen gerçekçi kapasitesinin (~420 Mbit/s)
# %70'i. BAŞKA SUNUCUYA TAŞINIRSA yeniden ölçüp güncelle:
#   curl -o /dev/null -s -w '%{speed_download}' https://fsn1-speed.hetzner.com/100MB.bin
RELAY_TOTAL_BYTES_PER_SECOND=37748736

# presence_subscribe/query ile takip edilebilecek azami ID
MAX_PRESENCE_IDS=200
MAX_PRESENCE_SUBSCRIPTIONS=500
