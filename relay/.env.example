# FluxConnect Relay Server — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Sunucu portu
PORT=8765

# TLS Sertifika yolları (production için zorunlu)
# TLS_CERT_PATH=./certs/cert.pem
# TLS_KEY_PATH=./certs/key.pem

# Geliştirme modunda TLS olmadan çalıştır (production'da false olmalı)
DEV_NO_TLS=true

# Rate limiting: IP başına saniyede max bağlantı isteği
RATE_LIMIT_PER_SECOND=10

# Bağlantı isteği zaman aşımı (ms) — kabul edilmezse otomatik iptal
SESSION_TIMEOUT_MS=30000

# Yanlış şifre sonrası kilit süresi (ms)
BRUTE_FORCE_LOCK_MS=30000

# Maksimum yanlış şifre denemesi
MAX_PASSWORD_ATTEMPTS=5
