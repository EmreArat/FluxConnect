<Window x:Class="FluxConnect.Desktop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxConnect"
        Height="600" Width="900"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================= -->
        <!-- SOL PANEL — Kimlik & Durum                              -->
        <!-- ======================================================= -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="24">

                <!-- Logo & Başlık -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="FluxConnect"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="Güvenli Uzaktan Bağlantı"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bu Makine ID -->
                <TextBlock Text="Makine ID'niz"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <Border Background="{StaticResource SurfaceLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="TxtMachineId"
                                   Text="— — —"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtDisplayName"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnCopyId"
                        Content="📋  ID'yi Kopyala"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnCopyId_Click"
                        Margin="0,0,0,24"/>

                <!-- Durum Göstergesi -->
                <TextBlock Text="BAĞLANTI DURUMU"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="{StaticResource DangerBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="Bağlanıyor..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"/>
                </StackPanel>

                <!-- Ayracı -->
                <Separator Background="{StaticResource BorderBrush}"
                           Margin="0,24,0,24"/>

                <!-- Hedef Kontrol Paneli (Başlangıçta gizli) -->
                <StackPanel x:Name="TargetControlPanel" Visibility="Collapsed" Margin="0,0,0,24">
                    <TextBlock Text="MEVCUT OTURUM"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock x:Name="TxtConnectedPeer"
                               Text="Bağlanan: Bilinmiyor"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>
                    
                    <!-- Hedef Medya Kontrolleri -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="BtnTargetMic"
                                Style="{StaticResource IconButton}"
                                Content="🎙️"
                                ToolTip="Mikrofon (Kapalı)"
                                FontSize="16" Width="36" Padding="4" Margin="0,0,4,0"
                                Click="BtnTargetMic_Click"/>
                        <Button x:Name="BtnTargetSysAudio"
                                Style="{StaticResource IconButton}"
                                Content="🔊"
                                ToolTip="Sistem Sesi (Kapalı)"
                                FontSize="16" Width="36" Padding="4" Margin="0,0,4,0"
                                Click="BtnTargetSysAudio_Click"/>
                        <Button x:Name="BtnTargetWebcam"
                                Style="{StaticResource IconButton}"
                                Content="📷"
                                ToolTip="Webcam (Kapalı)"
                                FontSize="16" Width="36" Padding="4" Margin="0,0,4,0"
                                Click="BtnTargetWebcam_Click"/>
                        <Button x:Name="BtnTargetSendFile"
                                Style="{StaticResource IconButton}"
                                Content="📁"
                                ToolTip="Dosya Gönder"
                                FontSize="16" Width="36" Padding="4"
                                Click="BtnTargetSendFile_Click"/>
                    </StackPanel>
                    
                    
                    <Button x:Name="BtnTargetEndSession"
                            Content="Bağlantıyı Kes"
                            Style="{StaticResource DangerButton}"
                            Click="BtnTargetEndSession_Click" />
                </StackPanel>

                <!-- Ayarlar -->
                <Button x:Name="BtnSettings"
                        Content="⚙  Ayarlar"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnSettings_Click"/>
            </StackPanel>
        </Border>

        <!-- ======================================================= -->
        <!-- SAĞ PANEL — Bağlan                                      -->
        <!-- ======================================================= -->
        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Uzak Bilgisayara Bağlan"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Bağlanmak istediğiniz makinenin ID veya IP adresini girin."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Bağlantı Kartı -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    VerticalAlignment="Top">
                <StackPanel>

                    <!-- Hedef ID veya IP -->
                    <StackPanel>
                        <TextBlock Text="Hedef Makine ID veya IP Adresi"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="TxtTargetId"
                                 Style="{StaticResource ModernTextBox}"
                                 MaxLength="21"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 Text=""
                                 TextChanged="TxtTargetId_TextChanged"
                                 KeyDown="TxtTargetId_KeyDown"
                                 Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtLocalIp"
                                   Text=""
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                    </StackPanel>

                    <Button x:Name="BtnConnect"
                            Content="Bağlan"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="BtnConnect_Click"
                            Height="44"/>

                    <!-- Sonuç / Hata Mesajı -->
                    <TextBlock x:Name="TxtConnectMessage"
                               Text=""
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Kişi Listesi -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SON BAĞLANTILAR"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ContactsList">
                            <TextBlock x:Name="TxtNoContacts"
                                       Text="Henüz bağlantı yok."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
