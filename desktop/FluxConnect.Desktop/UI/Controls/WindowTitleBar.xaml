<UserControl x:Class="FluxConnect.Desktop.UI.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32"
             FontFamily="{StaticResource MainFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource WindowTitleBarBorder}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="AppIcon"
                   Grid.Column="0"
                   Source="pack://application:,,,/app.ico"
                   Width="16" Height="16"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="BtnMinimize"
                        Content="&#xE921;"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="Simge durumuna küçült"
                        Click="BtnMinimize_Click"
                        Visibility="{Binding ShowMinimize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button x:Name="BtnMaximize"
                        Content="&#xE922;"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="Ekranı kapla"
                        Click="BtnMaximize_Click"
                        Visibility="{Binding ShowMaximize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <Button x:Name="BtnClose"
                        Content="&#xE8BB;"
                        Style="{StaticResource WindowChromeCloseButton}"
                        ToolTip="Kapat"
                        Click="BtnClose_Click"
                        Visibility="{Binding ShowClose, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
