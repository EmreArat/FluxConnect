<Window x:Class="FluxConnect.Desktop.UI.FloatingTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Dosya Transferi" Height="122" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource MainFont}">

    <Border Background="{StaticResource FloatingPanelBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource FloatingBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar x:Name="TitleBar"
                                     Grid.Row="0"
                                     Title="Dosya Transferi"
                                     ShowMinimize="False"
                                     ShowMaximize="False"
                                     ShowIcon="False"/>

            <Grid Grid.Row="1" Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtTitle"
                           Text="Dosya Alınıyor..."
                           Foreground="{StaticResource TextOnDarkBrush}"
                           FontWeight="Bold"
                           FontSize="12"/>
                <TextBlock x:Name="TxtFileName"
                           Grid.Row="1"
                           Text="file.txt"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,4,0,4"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="2"
                             Style="{StaticResource ModernProgressBar}"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
