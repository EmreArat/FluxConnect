<Window x:Class="FluxConnect.Desktop.UI.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Güncelleme Mevcut"
        Height="380" Width="440"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Title="Güncelleme Mevcut"
                                 ShowMinimize="False"
                                 ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,16,24,8">
            <TextBlock x:Name="TxtHeadline"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Sürüm notları"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ScrollViewer Style="{StaticResource ModernScrollViewer}" MaxHeight="160">
                <TextBlock x:Name="TxtReleaseNotes"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <ProgressBar x:Name="Progress"
                         Style="{StaticResource ModernProgressBar}"
                         Height="8"
                         Margin="0,16,0,0"
                         Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <Button x:Name="BtnLater"
                    Content="Daha Sonra"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="BtnLater_Click"/>
            <Button x:Name="BtnUpdate"
                    Content="Güncelle"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    Click="BtnUpdate_Click"/>
        </StackPanel>
    </Grid>
</Window>
