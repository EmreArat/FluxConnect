<Window x:Class="FluxConnect.Desktop.UI.Dialogs.ConnectPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Bağlantı Şifresi"
        Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Title="Bağlantı Şifresi"
                                 ShowMinimize="False"
                                 ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,16,24,8">
            <TextBlock Text="Bağlantı isteği gönderildi."
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Hedef şifre kullanıyorsa girebilirsiniz. Manuel kabul de bekleyebilirsiniz."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Şifre (opsiyonel)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtPassword" Height="36" Padding="8,6"/>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="11"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <Button Content="Kapat"
                    Style="{StaticResource SecondaryButton}"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="BtnClose_Click"/>
            <Button Content="Şifre Gönder"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    Click="BtnSubmit_Click"/>
        </StackPanel>
    </Grid>
</Window>
