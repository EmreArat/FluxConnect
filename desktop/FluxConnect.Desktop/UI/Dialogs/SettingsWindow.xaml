<Window x:Class="FluxConnect.Desktop.UI.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Ayarlar"
        Height="520" Width="600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Title="Ayarlar"
                                 ShowMinimize="False"
                                 ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,16,24,8">
            <TextBlock Text="GENEL"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkStartWithWindows"
                          Grid.Column="0"
                          Content="Windows ile birlikte başlat"
                          Foreground="{StaticResource TextPrimaryBrush}"/>

                <CheckBox x:Name="ChkStartMinimizedToTray"
                          Grid.Column="1"
                          Content="Başlangıçta tepsiye küçült"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>

            <TextBlock Text="RELAY SUNUCUSU"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Sunucu adresi"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="TxtRelayUrl"
                     Style="{StaticResource ModernTextBox}"
                     Padding="12,7"
                     Margin="0,0,0,10"
                     ToolTip="Örnek: wss://relay.ornek.com:8765&#10;Karşı tarafın da aynı adresi kullanması gerekir. Boş bırakılırsa yalnızca LAN çalışır."/>

            <TextBlock Text="Sertifika parmak izi (SHA-256) — kendinden imzalı sertifika için"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="TxtRelayFingerprint"
                     Style="{StaticResource ModernTextBox}"
                     Padding="12,7"
                     FontSize="12"
                     Margin="0,0,0,18"
                     ToolTip="Örnek: 08:A7:0B:BF:21:52:03:9B:...&#10;Doluysa yalnızca bu sertifikaya sahip sunucuya bağlanılır. Geçerli sertifikanız varsa boş bırakın."/>

            <TextBlock Text="OTURUM ŞİFRESİ (OPSİYONEL)"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Şifre"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Şifre (tekrar)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,0,4"/>

                <PasswordBox x:Name="TxtSessionPassword"
                             Grid.Row="1" Grid.Column="0"
                             Height="34"
                             Padding="8,6"
                             ToolTip="Boş bırakılırsa şifre gerekmez. Doğru şifre, manuel kabul alternatifidir."/>

                <PasswordBox x:Name="TxtSessionPasswordConfirm"
                             Grid.Row="1" Grid.Column="2"
                             Height="34"
                             Padding="8,6"/>
            </Grid>

            <CheckBox x:Name="ChkClearPassword"
                      Content="Oturum şifresini kaldır"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,18"/>

            <TextBlock Text="GÜNCELLEME"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtVersion"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"/>

                    <TextBlock x:Name="TxtUpdateStatus"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="BtnCheckUpdate"
                        Grid.Column="1"
                        Content="Güncellemeleri kontrol et"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnCheckUpdate_Click"
                        ToolTip="Açılışta otomatik kontrol edilir; güncelleme varsa arka planda uygulanır."/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <Button Content="İptal"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Kaydet"
                    Style="{StaticResource PrimaryButton}"
                    Width="100"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
