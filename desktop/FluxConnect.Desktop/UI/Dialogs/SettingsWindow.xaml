<Window x:Class="FluxConnect.Desktop.UI.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Ayarlar"
        Height="520" Width="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Title="Ayarlar"
                                 ShowMinimize="False"
                                 ShowMaximize="False"/>

        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}" Margin="24,16,24,8">
            <StackPanel>
                <TextBlock Text="GENEL"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <CheckBox x:Name="ChkStartWithWindows"
                          Content="Windows ile birlikte başlat"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="ChkStartMinimizedToTray"
                          Content="Başlangıçta tepsiye küçült"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,20"/>

                <TextBlock Text="OTURUM ŞİFRESİ (OPSİYONEL)"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Boş bırakılırsa şifre gerekmez. Doğru şifre, manuel kabul alternatifidir."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="TxtSessionPassword"
                             Height="36"
                             Margin="0,0,0,6"
                             Padding="8,6"/>

                <PasswordBox x:Name="TxtSessionPasswordConfirm"
                             Height="36"
                             Margin="0,0,0,8"
                             Padding="8,6"/>

                <CheckBox x:Name="ChkClearPassword"
                          Content="Oturum şifresini kaldır"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,20"/>

                <TextBlock Text="GÜNCELLEME"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtVersion"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Açılışta otomatik kontrol edilir; güncelleme varsa arka planda uygulanır."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <Button x:Name="BtnCheckUpdate"
                        Content="Güncellemeleri kontrol et"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnCheckUpdate_Click"
                        Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtUpdateStatus"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <Button Content="İptal"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Kaydet"
                    Style="{StaticResource PrimaryButton}"
                    Width="100"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
