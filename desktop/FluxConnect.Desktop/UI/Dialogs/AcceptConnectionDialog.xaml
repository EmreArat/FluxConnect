<Window x:Class="FluxConnect.Desktop.UI.Dialogs.AcceptConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        Title="Bağlantı İsteği"
        Height="352" Width="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        Icon="pack://application:,,,/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                 ShowMinimize="False"
                                 ShowMaximize="False"/>

        <Grid Grid.Row="1" Margin="28,20,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔔  Gelen Bağlantı İsteği"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceLightBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TxtFromName"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFromId"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="bu bilgisayara bağlanmak istiyor."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PasswordPanel"
                        Grid.Row="2"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                <TextBlock Text="Bu makine için bağlantı şifresi zorunludur."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtPassword"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✗  Reddet"
                        Style="{StaticResource DangerButton}"
                        Click="BtnReject_Click"
                        Height="40"/>

                <Button Grid.Column="2"
                        Content="✓  Kabul Et"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnAccept_Click"
                        Height="40"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
