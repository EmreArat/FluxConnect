<Window x:Class="FluxConnect.Desktop.UI.Dialogs.AcceptConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bağlantı İsteği"
        Height="320" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔔  Gelen Bağlantı İsteği"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Bilgi -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceLightBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtFromName"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtFromId"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="bu bilgisayara bağlanmak istiyor."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Şifre Alanı (gerekirse görünür) -->
        <StackPanel x:Name="PasswordPanel"
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
            <TextBlock Text="Bu makine için bağlantı şifresi zorunludur."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="TxtPassword"
                     Style="{StaticResource ModernTextBox}"
                     IsReadOnly="True"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Butonlar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="✗  Reddet"
                    Style="{StaticResource DangerButton}"
                    Click="BtnReject_Click"
                    Height="40"/>

            <Button Grid.Column="2"
                    Content="✓  Kabul Et"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnAccept_Click"
                    Height="40"/>
        </Grid>
    </Grid>
</Window>
