<Window x:Class="FluxConnect.Desktop.UI.FloatingWebcamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluxConnect.Desktop.UI.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="240" Height="212"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource MainFont}">

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="{StaticResource FloatingPanelBrush}"
            BorderBrush="{StaticResource FloatingBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:WindowTitleBar x:Name="TitleBar"
                                     Grid.Row="0"
                                     ShowMinimize="False"
                                     ShowMaximize="False"
                                     ShowIcon="False"/>

            <Border Grid.Row="1"
                    Background="Black"
                    ClipToBounds="True">
                <Image x:Name="ImgWebcam"
                       Stretch="UniformToFill"/>
            </Border>

            <Border Grid.Row="1"
                    x:Name="WaitingOverlay"
                    Background="{StaticResource OverlayScrimBrush}">
                <TextBlock Text="Kamera bekleniyor..."
                           Foreground="{StaticResource TextMutedOnDarkBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
